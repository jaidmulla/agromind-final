# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agromind_db
DB_USER=agromind_user
DB_PASSWORD=password123

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change_this_to_a_super_long_random_256bit_secret_in_production

# ─── OpenAI (Required for AI Doctor + Vision) ────────────────────────────────
# Get key at: https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini

# ─── Weather API (Required for live weather) ─────────────────────────────────
# Get free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# ─── Twilio SMS (Required for SMS alerts) ──────────────────────────────────────
# Get at: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Email Service (Required for email alerts) ────────────────────────────────
# Using Nodemailer with Gmail (app password required)
# Or use SendGrid for production
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
# Or SendGrid API Key:
# SENDGRID_API_KEY=your_sendgrid_api_key

# ─── Firebase Cloud Messaging (Required for push notifications) ────────────────
# Download service account JSON from Firebase Console
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email@firebase.gserviceaccount.com

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001/api/v1
VITE_MAPBOX_TOKEN=pk.your-mapbox-token
