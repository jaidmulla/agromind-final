# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://agromind_user:password123@localhost:5432/agromind_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agromind_db
DB_USER=agromind_user
DB_PASSWORD=password123

# JWT
JWT_SECRET=change_this_to_a_256_bit_random_secret_key_in_production
JWT_EXPIRES_IN=7d

# OpenAI (get key from platform.openai.com)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini

# ML Service URL
ML_SERVICE_URL=http://localhost:5000

# Weather API (free at openweathermap.org)
OPENWEATHER_API_KEY=your_openweather_key_here

# Nearby disease alert radius (km)
NEARBY_ALERT_RADIUS_KM=5

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
